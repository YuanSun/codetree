# Copy to MathCompetition/.env (never commit it). Without DATABASE_URL + SESSION_SECRET the site still works,
# saving progress in each browser only (no sign-in).
# Database "postgres"; the app lives in its own schema "mathlab" next to "family_budget" and "lecture".
DATABASE_URL=postgresql://mathlab_app:CHANGE_ME@localhost:5432/postgres
# Your Postgres admin role (the one that ran db/init_role.sql), used only by `python3 userctl.py migrate`.
DATABASE_ADMIN_URL=postgresql://YOUR_ADMIN_ROLE@localhost:5432/postgres
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
