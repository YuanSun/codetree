{
  "manifest_version": 3,
  "name": "DSH Chrome Bridge",
  "version": "0.1.0",
  "description": "Lets your local DeepSeek Harness read, and with your permission act on, only the tabs you explicitly share.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Chrome Bridge",
    "default_popup": "popup.html"
  }
}
