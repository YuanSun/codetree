{
  "manifest_version": 3,
  "name": "DSH Chrome Bridge",
  "version": "0.2.0",
  "description": "Lets your local DeepSeek Harness read, and with your permission act on, only the tabs you share and the sites you allow.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Chrome Bridge",
    "default_popup": "popup.html"
  },
  "commands": {
    "kill-switch": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Stop sharing everything and switch actions off"
    }
  }
}
