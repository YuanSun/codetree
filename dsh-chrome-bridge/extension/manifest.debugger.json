{
  "manifest_version": 3,
  "name": "DSH Chrome Bridge (debugger)",
  "version": "0.3.0",
  "description": "DSH Chrome Bridge with the debugger lane: screenshots, accessibility tree and real input on allowlisted sites. Chrome shows a debugging banner on attached tabs.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Chrome Bridge",
    "default_popup": "popup.html"
  },
  "commands": {
    "kill-switch": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Stop sharing everything and switch actions off"
    }
  }
}
