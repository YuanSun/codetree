# Path to the vault (e.g. RyanSunRemote) on disk.
VAULT_PATH=/path/to/RyanSunRemote

# Postgres with pgvector. Defaults to Postgres on this same machine (see
# db/bootstrap_local.sql to set one up). Running the indexer/API on a
# different machine than Postgres lives on? Point this at that host's
# address instead of localhost — pgvector doesn't care which host you're
# on, only reachability.
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault

# OpenAI-compatible embeddings endpoint. LM Studio's chat models
# (gpt-oss-20b, qwen3-vl-30b) don't serve embeddings — load a dedicated
# embedding model (nomic-embed-text, bge-small, ...) on its own port.
EMBEDDING_API_URL=http://localhost:1234/v1/embeddings
EMBEDDING_MODEL=nomic-embed-text
# Must match the served model's output dimension:
#   nomic-embed-text -> 768, bge-small -> 384, bge-base -> 768
EMBEDDING_DIM=768

# Query API (used by the MCP wrapper and by scripts/init_db.py).
# API_HOST is what uvicorn binds to; API_BASE_URL is what the MCP wrapper
# calls. If the indexer/API run on a heavier machine (e.g. where Postgres
# and LM Studio also live) and MCP clients run elsewhere (e.g. a laptop),
# bind API_HOST to 0.0.0.0 (or that machine's LAN IP) and set
# API_BASE_URL on the client to that machine's LAN address instead of
# 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=8756
API_BASE_URL=http://127.0.0.1:8756

# Vault folders to skip when scanning.
IGNORED_FOLDERS=.obsidian,.trash,.git

# Indexer tuning.
WATCH_DEBOUNCE_SECONDS=2.0
EMBEDDING_BATCH_SIZE=32
