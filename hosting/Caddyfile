# One gateway for every personal web project. Run with:  ./run.sh
# Everything lives under ONE address, whatever name you reach this machine by
# (mac-studio.local, an IP, a Tailscale name, ...):
#     /        portal        /fund/   Fund Accounting Academy
#     /math/   MathCompetition        /notes/  family notes (password)
#     /budget/ family budget dashboard (Streamlit + Postgres, password)
# TLS is NOT handled here: Cloudflare Tunnel / Tailscale terminate it, so Caddy speaks plain HTTP.
{
	auto_https off
	admin off
}

(site_defaults) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}

http://:{$GATEWAY_PORT:12999} {
	import site_defaults

	# Fund Accounting Academy (pure static files, relative links)
	redir /fund /fund/
	handle_path /fund/* {
		root * {$FUND_DIR}
		file_server {
			hide server.py tests README.md
		}
	}

	# MathCompetition: the prefix is stripped here; the app is started with --base-path /math
	# so the links it generates point back under /math/.
	redir /math /math/
	handle_path /math/* {
		reverse_proxy 127.0.0.1:{$MATH_PORT:12998}
	}

	# Family Obsidian notes (static site from build-notes.sh). Private: password-protected here;
	# also put Cloudflare Access / Tailscale in front before exposing it beyond your home network.
	redir /notes /notes/
	handle_path /notes/* {
		basic_auth {
			{$NOTES_USER} {$NOTES_HASH}
		}
		root * {$HOSTING_DIR}/sites/notes
		# Quartz links have no extension (/page, not /page.html): try the .html file and folder index.
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	# Family budget dashboard (Streamlit). Unlike /math/ the prefix is NOT stripped: Streamlit is
	# started with --server.baseUrlPath budget and serves everything under /budget/ itself.
	# Private financial data: same login as the notes, on top of the dashboard's own admin login.
	# reverse_proxy passes the websocket Streamlit uses for live updates.
	redir /budget /budget/
	handle /budget/* {
		basic_auth {
			{$NOTES_USER} {$NOTES_HASH}
		}
		reverse_proxy 127.0.0.1:{$BUDGET_PORT:12997}
	}

	# Safety net for the notes site: if Quartz emits a root-absolute link (/some/page instead of
	# /notes/some/page), the click arrives here with the notes page as Referer. Send it back under /notes/.
	@notes_stray {
		header_regexp Referer ^https?://[^/]+/notes/
		not path / /fund/* /math/* /budget/* /notes/*
	}
	handle @notes_stray {
		redir /notes{uri} 302
	}

	# Portal at the root
	handle {
		root * {$HOSTING_DIR}/portal
		file_server
	}
}
