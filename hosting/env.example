# Copy to hosting/.env and edit. Never commit .env.
GATEWAY_PORT=12999
MATH_PORT=12998
BUDGET_PORT=12997
# one login protects both /notes/ and /budget/
NOTES_USER=family
# generate with:  caddy hash-password
NOTES_HASH=
# path to the family Obsidian vault (used by build-notes.sh)
VAULT=
# optional: publish only these folders of the vault (comma-separated, relative to VAULT); empty = everything
VAULT_DIRS=
# optional: how you reach the gateway, host[:port] (default localhost:<GATEWAY_PORT>)
NOTES_BASE_URL=
