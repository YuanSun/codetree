# Copy to lecture-magique/.env (never commit it).
# Database "postgres"; the app lives in its own schema "lecture" next to "family_budget".
DATABASE_URL=postgresql+psycopg://lecture_app:CHANGE_ME@localhost:5432/postgres
# Your Postgres admin role (the one that ran init_role.sql, e.g. RyanSun), used only by migrations and importers.
# Drop ":CHANGE_ME" if that role has no password.
DATABASE_ADMIN_URL=postgresql+psycopg://YOUR_ADMIN_ROLE:CHANGE_ME@localhost:5432/postgres
ROBERT_LD2_PATH=/path/to/Le_Nouveau_Petit_Robert_de_la_langue_francaise_2007.ld2
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
PORT=8090
# 0.0.0.0 = other devices can open http://<mac>.local:8090/ directly.
# 127.0.0.1 = only the family gateway can reach it (use http://<mac>.local:12999/lecture/).
HOST=0.0.0.0
