# Copy to lecture-magique/.env (never commit it).
# Database "postgres"; the app lives in its own schema "lecture" next to "family_budget".
DATABASE_URL=postgresql+psycopg://lecture_app:CHANGE_ME@localhost:5432/postgres
# Admin account, used only by migrations (alembic) and the importers.
DATABASE_ADMIN_URL=postgresql+psycopg://ryan:CHANGE_ME@localhost:5432/postgres
ROBERT_LD2_PATH=/path/to/Le_Nouveau_Petit_Robert_de_la_langue_francaise_2007.ld2
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
PORT=8090
